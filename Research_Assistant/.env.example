OPENALEX_EMAIL=
OPENALEX_API_KEY=
SECRET_KEY=
OPENROUTER_API_KEY=
# Security settings
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_SITE_URL=https://127.0.0.1:8080
OPENROUTER_SITE_NAME=Research_AI_Assistant
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# The free-model list is discovered from the OpenRouter models API and cached.
OPENROUTER_MODELS_CACHE_SECONDS=21600
# Forces OPENROUTER_MODEL to be attempted first. This overrides the reliability
# ranking, and so also the circuit breaker: a model that keeps failing stays
# first. Leave false unless you are deliberately pinning one model.
OPENROUTER_PIN_DEFAULT_MODEL=false